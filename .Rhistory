mses <- rep(0, length(lambdas))
#install.packages("glmnet")
library(MASS)
library(glmnet)
lambdas <- seq(20, 0, by = -0.1)
y <- Cars93$Price
X <- model.matrix(~ MPG.highway + MPG.city + EngineSize + Horsepower + RPM + Passengers + Width + Length + Wheelbase +
Rev.per.mile + Fuel.tank.capacity + Weight + Turn.circle + Origin - 1, data = Cars93)
mses <- rep(0, length(lambdas))
for(i in 1:length(lambdas)){
mse_i <- rep(0, nrow(X))
for(j in 1:nrow(X)){
fit <- glmnet(X[-j,], y[-j], alpha=0, lambda=lambdas[i])
pred <- predict(fit, X[j,,drop=FALSE])
mse_i[j] <- (y[j] - pred)^2
}
mses[i] <- mean(mse_i)
}
best_lambda_ridge <- lambdas[which.min(mses)]
best_mse_ridge <- min(mses)
plot(lambdas, mses, type="l")
abline(v = best_lambda_ridge, col="red")
best_lambda_ridge
best_mse_ridge
mses_lasso <- rep(0, length(lambdas))
for(i in 1:length(lambdas)){
mse_i <- rep(0, nrow(X))
for(j in 1:nrow(X)){
fit <- glmnet(X[-j,], y[-j], alpha=1, lambda=lambdas[i])
pred <- predict(fit, X[j,,drop=FALSE])
mse_i[j] <- (y[j] - pred)^2
}
mses_lasso[i] <- mean(mse_i)
}
best_lambda_lasso <- lambdas[which.min(mses_lasso)]
best_mse_lasso <- min(mses_lasso)
best_lambda_lasso
best_mse_lasso
best_mse_ridge
fit_best <- glmnet(X, y, alpha=1, lambda=best_lambda_lasso)
coef_best <- coef(fit_best)
coef_best
sum(coef_best != 0)
set.seed(1)
cv_ridge <- cv.glmnet(X, y, alpha=0)
plot(cv_ridge)
cv_ridge$lambda.min
min(cv_ridge$cvm)
best_lambda_ridge
best_mse_ridge
cv_ridge$lambda.min
min(cv_ridge$cvm)
best_lambda_ridge
best_mse_ridge
set.seed(1)
cv_lasso <- cv.glmnet(X, y, alpha=1)
plot(cv_lasso)
cv_lasso$lambda.min
min(cv_lasso$cvm)
best_lambda_lasso
best_mse_lasso
best_mse_ridge
lambda_1se <- cv_lasso$lambda.1se
lambda_1se
fit_1se <- glmnet(X, y, alpha=1, lambda=lambda_1se)
coef_1se <- coef(fit_1se)
coef_1se
sum(coef_1se != 0)
