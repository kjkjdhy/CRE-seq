data(mcycle)
x = mcycle$times # Time (ms) after impact
y = mcycle$accel # Acceleration (g)
plot(x,y)
plot(x, y)
for(d in 1:10){
fit <- lm(y ~ poly(x, d))
lines(sort(x), fitted(fit)[order(x)], col = d)
}
library(splines)
plot(x, y)
for(k in c(10, 20, 100)){
knots <- seq(min(x), max(x), length.out = k + 2)[2:(k+1)]
fit <- lm(y ~ bs(x, knots = knots, degree = 1, intercept = TRUE))
lines(sort(x), fitted(fit)[order(x)], col = k)
}
fit_gam_spline <- gam(y ~ s(x))
plot(x, y)
lines(sort(x), fitted(fit_gam_spline)[order(x)])
